# ── Alpaca (paper trading only) ───────────────────────────────────────────────
# Create a NEW, dedicated paper account for the hackathon, set its starting
# balance to $100,000, and paste its keys here. The account ID goes in the
# submission so judges can audit P&L.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true            # never set to false in this project

# ── LLM (OpenAI-compatible endpoint) ──────────────────────────────────────────
# Any OpenAI-compatible /v1 endpoint: a local Ollama, Featherless, etc.
# The model only proposes a direction; it never does arithmetic.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed-for-local
LLM_MODEL=qwen3.5:9b
LLM_TIMEOUT_SECONDS=45

# ── Datastores ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=optionwright
POSTGRES_USER=optionwright
POSTGRES_PASSWORD=change-me
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ── Agent behavior ────────────────────────────────────────────────────────────
CYCLE_SECONDS=300            # how often the agent evaluates the market
UNDERLYINGS=SPY,QQQ         # liquid weeklies only — this whitelist is a risk gate
LOG_LEVEL=INFO
