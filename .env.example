# ── Alpaca (paper trading only) ───────────────────────────────────────────────
# Create a NEW, dedicated paper account, set its balance to $100,000, and paste
# its keys here. The account ID goes in the submission so judges can audit P&L.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true               # the agent refuses to start with false

# ── LLM: primary (OpenAI-compatible) + optional local fallback ────────────────
# Primary can be Featherless, OpenAI, or a local Ollama. The model only proposes
# a direction; it never does arithmetic and never sizes a trade.
LLM_BASE_URL=https://api.featherless.ai/v1
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
LLM_API_KEY=
LLM_NATIVE_OLLAMA=false         # true only when LLM_BASE_URL is an Ollama (uses /api/chat, think=false)
LLM_TIMEOUT_SECONDS=60
# Local fallback used only if the primary errors or returns empty. Leave the
# URL empty to disable.
FALLBACK_LLM_BASE_URL=http://localhost:11434/v1
FALLBACK_LLM_MODEL=qwen3.5:9b

# ── Datastore ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=optionwright
POSTGRES_USER=optionwright
POSTGRES_PASSWORD=change-me

# ── Agent behavior ────────────────────────────────────────────────────────────
CYCLE_SECONDS=180               # entries pass (3 underlyings, chain + LLM) takes ~90-130s
EXIT_CHECK_SECONDS=60           # exits pass (one quote per open position) — keeps the trailing tight
UNDERLYINGS=SPY,QQQ,IWM         # liquid weeklies only — this whitelist is a risk gate
EXPIRY_MIN_DAYS=2               # target days-to-expiration window
EXPIRY_MAX_DAYS=3
AGENT_RICH_CONTEXT=true         # feed the LLM market signals + recent outcomes + the open book
LOG_LEVEL=INFO

# ── Rule parameters: SEEDS ONLY ───────────────────────────────────────────────
# Since 0.5.0 the gates and the exits read their thresholds from the `rules`
# table in Postgres (scopes global / group:<name> / underlying:<SYM>, with a
# history of every change). These values seed the GLOBAL scope the first time
# the agent starts against an empty table; afterwards edit through
# PATCH /api/rules (needs RULES_TOKEN) or SQL. Registry: optionwright/policy/params.py
# Full rule list and order: docs/RULES.md
#
# entries · gates (each can veto or shrink; none can enlarge)
MAX_OPEN_POSITIONS=6
MAX_PER_UNDERLYING=2
MAX_LOSS_PCT=0.01               # max loss per position, fraction of equity
DAILY_BUDGET_PCT=0.05           # capital-at-risk deployable per day
MAX_DIRECTION_SHARE=0.60        # no side above 60% of open risk (first position exempt)
MAX_NET_DELTA_PCT=0.03          # |net delta of the book| in $ as a fraction of equity
MIN_REWARD_RISK=0.20            # credit / max loss floor for a candidate spread
MIN_CONFIDENCE=0.6              # only open when the LLM is at least this sure
COOLDOWN_SECONDS=2700           # per-underlying re-entry cooldown (45 min)
MAX_CONSECUTIVE_LOSSES=3
MAX_DAILY_LOSS_PCT=0.02         # realized loss today that pauses new entries
OPENING_BLACKOUT_MINUTES=30
NO_ENTRY_MINUTES_BEFORE_CLOSE=60
MACRO_BLACKOUT_MINUTES=60
#
# exits · by state
STOP_DELTA=0.45                 # close when the short leg's |delta| reaches this
STOP_LOSS_MULT=1.0              # ...and never lose more than 1x the credit
TAKE_PROFIT_FAR=0.50            # take-profit with more than TAKE_PROFIT_STEP_HOURS to expiry
TAKE_PROFIT_NEAR=0.25           # take-profit in the last hours
TAKE_PROFIT_STEP_HOURS=24
TRAIL_ACTIVATION=0.30           # trailing take-profit arms at 30% captured
TRAIL_GIVEBACK=0.07             # ...and closes if captured falls 7 pts below its peak
OVERNIGHT_MODE=flat             # flat = close everything before the close; delta = sleep only if small and balanced
FLATTEN_MINUTES_BEFORE_CLOSE=30
OVERNIGHT_MAX_SHORT_DELTA=0.35  # delta mode
OVERNIGHT_NET_DELTA_PCT=0.03    # delta mode
#
# RULES_TOKEN=                  # Bearer token for PATCH /api/rules; empty = edits disabled
